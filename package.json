{
  "name": "nyxiontech-pdf-tools",
  "private": true,
  "version": "1.1.0",
  "description": "Free, open-source PDF and image tools that run entirely in the browser. Files are never uploaded.",
  "license": "AGPL-3.0-or-later",
  "author": "Nyxiontech (https://nyxiontech.com)",
  "homepage": "https://github.com/jurecki007/nyxiontech-tools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurecki007/nyxiontech-tools.git"
  },
  "bugs": {
    "url": "https://github.com/jurecki007/nyxiontech-tools/issues"
  },
  "funding": [
    "https://ko-fi.com/nyxiontech"
  ],
  "keywords": [
    "pdf",
    "pdf-editor",
    "ocr",
    "privacy",
    "browser",
    "offline",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/check-doc-links.mjs && node scripts/check-pages-headers.mjs && node scripts/check-third-party-notices.mjs && node scripts/copy-assets.mjs",
    "notices:check": "node scripts/check-third-party-notices.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "images:check": "node scripts/check-image-tags.mjs",
    "notices:fix": "node scripts/check-third-party-notices.mjs --fix",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:offline": "node scripts/build-desktop-offline.mjs",
    "test:desktop": "playwright test -c playwright.desktop.config.ts",
    "og:build": "node scripts/build-og-images.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@expo-google-fonts/arimo": "0.4.3",
    "@expo-google-fonts/caveat": "0.4.2",
    "@expo-google-fonts/cousine": "0.4.3",
    "@expo-google-fonts/dancing-script": "0.4.2",
    "@expo-google-fonts/eb-garamond": "0.4.3",
    "@expo-google-fonts/great-vibes": "0.4.1",
    "@expo-google-fonts/lato": "0.4.1",
    "@expo-google-fonts/merriweather": "0.4.2",
    "@expo-google-fonts/montserrat": "0.4.2",
    "@expo-google-fonts/open-sans": "0.4.2",
    "@expo-google-fonts/oswald": "0.4.2",
    "@expo-google-fonts/playfair-display": "0.4.2",
    "@expo-google-fonts/pt-serif": "0.4.1",
    "@expo-google-fonts/roboto": "0.4.3",
    "@expo-google-fonts/roboto-mono": "0.4.2",
    "@expo-google-fonts/source-sans-3": "0.4.2",
    "@expo-google-fonts/tinos": "0.4.2",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/pol": "1.0.0",
    "dejavu-fonts-ttf": "2.37.3",
    "docx": "9.15.0",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "heic-to": "1.6.6",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.66.0",
    "mammoth": "1.13.0",
    "onnxruntime-web": "1.31.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
